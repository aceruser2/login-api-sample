from sqlalchemy.orm import Session
from sqlalchemy import select, func
from datetime import datetime, timedelta

from app.model import Order, OrderItem, MenuItem
from app.schema import DailySalesReport, PopularItemReport
from app.extension.emun_setting import OrderStatusEnum


def get_daily_sales(db: Session, date: datetime):
    """Generate daily sales report"""
    if not date:
        date = datetime.now()

    start_date = date.replace(hour=0, minute=0, second=0, microsecond=0)
    end_date = start_date + timedelta(days=1)

    query = select(
        func.count(Order.uuid).label("total_orders"),
        func.coalesce(func.sum(Order.total_amount), 0).label("total_sales"),
    ).where(
        Order.create_dt >= start_date,
        Order.create_dt < end_date,
        Order.status == OrderStatusEnum.COMPLETED.value,
        Order.soft_delete == False,
    )

    result = db.execute(query).first()

    if not result:
        return DailySalesReport(
            date=date, total_sales=0, total_orders=0, average_order_value=0
        )

    return DailySalesReport(
        date=date,
        total_sales=result.total_sales,
        total_orders=result.total_orders,
        average_order_value=(
            result.total_sales / result.total_orders if result.total_orders > 0 else 0
        ),
    )


def get_popular_items(
    db: Session, start_date: datetime, end_date: datetime, limit: int = 10
):
    """Get most popular menu items"""
    query = (
        select(
            MenuItem.uuid,
            MenuItem.name,
            func.sum(OrderItem.quantity).label("quantity_sold"),
            func.sum(OrderItem.subtotal).label("total_sales"),
        )
        .join(OrderItem, OrderItem.item_uuid == MenuItem.uuid)
        .join(Order, Order.uuid == OrderItem.order_uuid)
        .where(
            Order.create_dt >= start_date,
            Order.create_dt < end_date,
            Order.status == "completed",
            Order.soft_delete == False,
        )
        .group_by(MenuItem.uuid, MenuItem.name)
        .order_by(func.sum(OrderItem.quantity).desc())
        .limit(limit)
    )

    results = db.execute(query).all()

    return [
        PopularItemReport(
            item_uuid=r.uuid,
            item_name=r.name,
            quantity_sold=r.quantity_sold,
            total_sales=r.total_sales,
        )
        for r in results
    ]
